# ============================================================
# 单一配置入口。复制为 .env 后按需修改；带【填：】的项目必须由你亲自决定/填写。
# 未设置任何变量时，项目以「全离线、确定性、无外部模型调用」模式运行（LLM_PROVIDER=template）。
# ============================================================

# ---------- 模型（F-005/F-017：本地或云 API，配置切换） ----------
# template = 内置确定性模板生成器（零依赖、可复跑、测试与评测默认走这条）
# ollama   = 本机 Ollama（需自行启动服务）
# openai   = 任意 OpenAI 兼容 /chat/completions 端点
LLM_PROVIDER=template

# LLM_PROVIDER=ollama 时使用
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=【填：本地模型名，如 qwen2.5:7b-instruct】
# 本机显存上限（仅用于 README/文档里的口径说明，不参与逻辑）
OLLAMA_VRAM_LIMIT=【填：本地显存上限，如 8GB】

# LLM_PROVIDER=openai 时使用（密钥请勿提交进仓库）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=【填：云 API Key，不使用则留空】
OPENAI_MODEL=【填：云模型名】

# ---------- 检索 / 知识库（F-006） ----------
# bm25（默认，纯 stdlib 实现）| bge-m3（需 requirements.txt 可选项，失败自动降级 bm25 并记录）
KB_EMBEDDING=bm25
KB_TTL_SECONDS=300
KB_TOP_K=5
# 评测/演示时的「查询时点」，留空表示用系统当前时间（双时态检索用）
KB_AS_OF=

# ---------- 工具层（F-005） ----------
TOOL_TIMEOUT_MS=3000

# ---------- 门禁（F-008–F-012） ----------
# 综合置信度低于该值 → 只解释 + 主动转人工，禁止硬答（F-012）
CONFIDENCE_THRESHOLD=0.55
# 紧急词表（命中即自动转人工，F-009）可在该文件追加
URGENCY_LEXICON=data/gates/urgency_lexicon.txt

# ---------- 多轮（F-007） ----------
CONTEXT_TOKEN_BUDGET=1500
MAX_RECENT_TURNS=12

# ---------- 服务编排（一键启动/停止，见 docs/服务编排说明.md） ----------
# 要编排哪些服务，逗号分隔：api（本仓库自带的 HTTP 服务）, ollama（外部进程，默认不接管）
OPS_SERVICES=api
APP_HOST=127.0.0.1
APP_PORT=8080
# 优雅停机时等待在途请求结束的最长秒数
DRAIN_SECONDS=5
# 是否由编排器负责拉起/停止本机 ollama serve（1=接管）。默认 0：只做健康探测，不动你的进程。
OLLAMA_TAKEOVER=0
OLLAMA_BIN=ollama

# ---------- 存储 ----------
SHOP_DB_PATH=data/synthetic_shop/shop.db
AUDIT_DB_PATH=data/synthetic_shop/audit.db

# ---------- 业务口径（不做真实店铺，R7） ----------
# 合成单店锁定的经营类目：服饰 / 3C数码 / 生鲜 三选一（方案待填项，默认 3C数码）
SHOP_CATEGORY=3C数码
# 目标投递日期（仅文档口径用）
TARGET_APPLICATION_DATE=【填：B6 目标投递日期】
# 月度现金上限（本项目默认零现金调用云 API，不使用 openai  provider 可留空）
MONTHLY_CASH_CAP=【填：B8 月度现金上限与账单】
# 是否注册个体工商户（本项目不涉及，仅方案待填项）
SOLE_PROPRIETOR_STATUS=【填：B9 是否注册个体工商户】

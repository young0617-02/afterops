# Copy to .env.prod (never commit) and replace every value.
SITE_ADDRESS=afterops.localhost
PUBLIC_BASE_URL=https://afterops.localhost:8443
HTTP_PORT=8080
HTTPS_PORT=8443

POSTGRES_PASSWORD=replace-with-strong-db-password
SESSION_SECRET=replace-with-at-least-32-random-characters
MOCK_PSP_SECRET=replace-with-at-least-16-random-chars
AUDIT_ANCHOR_SECRET=replace-with-at-least-32-random-characters
DEMO_OWNER_PASSWORD=replace-owner-password
DEMO_AGENT_PASSWORD=replace-agent-password

SMTP_FROM=afterops@local
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
# optional observability overlay ports (localhost only)
PROD_PROMETHEUS_PORT=19090
PROD_ALERTMANAGER_PORT=19093
PROD_ALERT_SINK_PORT=18081
PROD_GRAFANA_PORT=13001
PROD_TEMPO_PORT=13200
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-grafana-password
LLM_PROVIDER=template
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

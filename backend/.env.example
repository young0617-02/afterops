APP_ENV=dev
# 允许携带浏览器 Origin 的写请求来源（逗号分隔）
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000
DEMO_MERCHANT_NAME=AfterOps 演示 3C 店
DATABASE_URL=postgresql+psycopg://afterops:afterops@127.0.0.1:5433/afterops
SESSION_SECRET=dev-only-change-me
MOCK_PSP_SECRET=dev-only-change-me
DEMO_OWNER_PASSWORD=owner123456
DEMO_AGENT_PASSWORD=agent123456
COMPENSATION_MAX_CENTS=50000

# 顾客手机号 OTP（本地未接短信服务，开发环境在响应里返回 debug_code）
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=600
LOGIN_LIMIT=10
LOGIN_WINDOW_SECONDS=600

# 限流
ADMIN_LOGIN_LIMIT=5
ADMIN_LOGIN_WINDOW_SECONDS=600
CHAT_LIMIT=30
CHAT_WINDOW_SECONDS=60
CHECKOUT_LIMIT=10
CHECKOUT_WINDOW_SECONDS=60

# text | json（json 便于容器日志采集）
LOG_FORMAT=text
# 留空关闭 tracing；容器内示例：http://tempo:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=afterops-api

# template = 确定性模板（默认）；ollama / openai = 只改写已批准回复
# 本机直跑 API 用 127.0.0.1；容器内访问宿主机 Ollama 用 host.docker.internal
LLM_PROVIDER=template
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_MS=20000

# 客服邮件通知（本地 Mailpit SMTP 默认 127.0.0.1:1025）
EMAIL_NOTIFY_ENABLED=true
CUSTOMER_EMAIL_NOTIFY_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=afterops@local
ADMIN_BASE_URL=http://127.0.0.1:3000
OUTBOX_POLL_SECONDS=5
OUTBOX_MAX_ATTEMPTS=5
RETURN_ADDRESS=上海市青浦区华新镇华志路 168 号 AfterOps 退货仓
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
ORDER_AUTO_COMPLETE_DAYS=7
ORDER_AUTO_COMPLETE_INTERVAL_SECONDS=3600
ORDER_EXPIRE_INTERVAL_SECONDS=60
LOW_STOCK_THRESHOLD=5
PROPOSAL_SLA_MINUTES=30
HANDOFF_SLA_MINUTES=15
HANDOFF_SLA_HIGH_MINUTES=10
HANDOFF_SLA_URGENT_MINUTES=5
SLA_REMINDER_INTERVAL_SECONDS=300
AUDIT_ANCHOR_DIR=anchors
AUDIT_ANCHOR_SECRET=dev-only-anchor-secret-change-me
AUDIT_ANCHOR_INTERVAL_SECONDS=86400
